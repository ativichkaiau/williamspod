# WilliamsPod environment

# Required: signs the session cookie. Generate with: openssl rand -hex 32
WILLIAMSPOD_AUTH_SECRET=replace-with-random-hex-string

# Required: libSQL connection. Local: file:./williamspod.db. Prod (Turso): libsql://...
DATABASE_URL=file:./williamspod.db

# Required for Turso (production)
# DATABASE_AUTH_TOKEN=

# Optional: default WilliamsHub origin used by POST /api/hub/import.
# Can also be supplied per request as `baseUrl`.
# WILLIAMSHUB_URL=https://williamshub.vercel.app

# ----- Admin bootstrap (used by `npm run setup:admin`) -----
# Display name for the admin user (default: "admin").
WILLIAMSPOD_ADMIN_NAME=admin
# Admin passphrase. >= 6 characters. Re-running setup:admin rotates this.
WILLIAMSPOD_ADMIN_PASSWORD=change-me

# ----- Legacy (single-user). setup:admin will read WILLIAMSPOD_PASSWORD if
# WILLIAMSPOD_ADMIN_PASSWORD isn't set, easing migration. Safe to remove after
# you've bootstrapped your admin account.
# WILLIAMSPOD_PASSWORD=
