# WilliamsPod environment

# Single-user password gate. Required.
WILLIAMSPOD_PASSWORD=changeme

# Secret used to sign the auth cookie. Required. Generate with: openssl rand -hex 32
WILLIAMSPOD_AUTH_SECRET=replace-with-random-hex-string

# libSQL connection. Local: file:./williamspod.db. Prod (Turso): libsql://...
DATABASE_URL=file:./williamspod.db

# Optional Turso auth token (prod only)
# DATABASE_AUTH_TOKEN=
